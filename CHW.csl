<?xml version="1.0" encoding="utf-8"?>

<style xmlns="http://purl.org/net/xbiblio/csl"
       version="1.0"
       class="in-text"
       default-locale="en-US">

<info>
<title>CHW GB/T 7714-2015 Numeric</title>

<id>https://github.com/jichao181/GB-T-7714-Mendeley/CHW</id>

<updated>2026-09-30T00:00:00+00:00</updated>

</info>

<!-- ========================================================= -->
<!-- 中文 -->
<!-- ========================================================= -->

<locale xml:lang="zh-CN">
<terms>
<term name="et-al">等</term>
<term name="page-range-delimiter">-</term>
</terms>
</locale>

<!-- ========================================================= -->
<!-- 英文 -->
<!-- ========================================================= -->

<locale xml:lang="en">
<terms>
<term name="et-al">et al</term>
<term name="page-range-delimiter">-</term>
</terms>
</locale>

<!-- ========================================================= -->
<!-- 作者 -->
<!-- ========================================================= -->

<macro name="author">

<names variable="author">

<name
name-as-sort-order="all"
sort-separator=" "
initialize-with=" "
delimiter=", "
delimiter-precedes-et-al="always"
et-al-min="4"
et-al-use-first="3"/>

<substitute>
<names variable="editor"/>
</substitute>

</names>

</macro>

<!-- ========================================================= -->
<!-- 文献类型 -->
<!-- ========================================================= -->

<macro name="type">

<choose>

<if
type="article-journal article-magazine periodical"
match="any">

<text value="J"/>

</if>

<else-if type="article-newspaper">

<text value="N"/>

</else-if>

<else-if type="paper-conference">

<text value="C"/>

</else-if>

<else-if
type="book chapter entry-dictionary entry-encyclopedia"
match="any">

<text value="M"/>

</else-if>

<else-if type="thesis">

<text value="D"/>

</else-if>

<else-if type="patent">

<text value="P"/>

</else-if>

<else-if type="report">

<text value="R"/>

</else-if>

<else-if type="standard">

<text value="S"/>

</else-if>

<else>

<text value="Z"/>

</else>

</choose>

</macro>

<!-- ========================================================= -->
<!-- 题名 + 文献类型 -->
<!-- ========================================================= -->

<macro name="title">

<group delimiter="">

<text
variable="title"
text-case="sentence"/>

<group
prefix="["
suffix="]">

<text macro="type"/>

</group>

</group>

</macro>

<!-- ========================================================= -->
<!-- 年 -->
<!-- ========================================================= -->

<macro name="year">

<date
variable="issued"
form="numeric"
date-parts="year"/>

</macro>

<!-- ========================================================= -->
<!-- 期刊信息 -->
<!-- ========================================================= -->

<macro name="journal">

<group delimiter=", ">

<!-- 期刊名 -->

<text variable="container-title"/>

<!-- 年 -->

<text macro="year"/>

<!-- 卷(期) -->

<group delimiter="">

<text variable="volume"/>

<text
variable="issue"
prefix="("
suffix=")"/>

</group>

</group>

</macro>

<!-- ========================================================= -->
<!-- 页码 -->
<!-- ========================================================= -->

<macro name="pages">

<text variable="page"/>

</macro>

<!-- ========================================================= -->
<!-- 文中引用 -->
<!-- ========================================================= -->

<citation>

<layout
prefix="["
suffix="]"
delimiter=",">

<text variable="citation-number"/>

</layout>

</citation>

<!-- ========================================================= -->
<!-- 参考文献 -->
<!-- ========================================================= -->

<bibliography
entry-spacing="0"
line-spacing="1">

<layout suffix=".">

<!-- [1] -->

<text
variable="citation-number"
prefix="["
suffix="]"/>

<!-- 作者 -->

<text
macro="author"
suffix=". "/>

<choose>

<!-- ================================================= -->
<!-- 期刊论文 -->
<!-- ================================================= -->

<if
type="article-journal article-magazine article-newspaper periodical"
match="any">

<!-- 题名[J] -->

<text
macro="title"
suffix=". "/>

<!-- 期刊, 年, 卷(期): 页码 -->

<group delimiter=": ">

<text macro="journal"/>

<text macro="pages"/>

</group>

</if>

<!-- ================================================= -->
<!-- 其他文献 -->
<!-- ================================================= -->

<else>

<text
macro="title"
suffix=". "/>

<text macro="year"/>

</else>

</choose>

</layout>

</bibliography>

</style>
